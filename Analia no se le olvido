import os
import pandas as pd
import tkinter as tk
from tkinter import ttk, messagebox
"""
This is where the FILE CONFIGURATION is
"""
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
BOOKS_FILE = os.path.join(BASE_DIR, "books.csv")
HISTORY_FILE = os.path.join(BASE_DIR, "user_history.csv")
LANGUAGES = ["English", "Spanish"]
GENRES = ["Fantasy", "Adventure", "Fiction", "Self-help"]
"""
Part of the FILE MANAGEMENT YAY
"""
def create_history_file():
    if not os.path.exists(HISTORY_FILE):
        df = pd.DataFrame(columns=["Name", "Age", "Language", "Genre"])
        df.to_csv(HISTORY_FILE, index=False)
def create_books_file():
    if not os.path.exists(BOOKS_FILE):
        books = pd.DataFrame(
            [
                {
                    "Title": "The Hobbit",
                    "Genre": "Fantasy",
                    "Language": "English",
                    "MinAge": 16,
                    "MaxAge": 18,
                },
                {
                    "Title": "Atomic Habits",
                    "Genre": "Self-help",
                    "Language": "English",
                    "MinAge": 14,
                    "MaxAge": 100,
                },
                {
                    "Title": "Don Quixote",
                    "Genre": "Adventure",
                    "Language": "Spanish",
                    "MinAge": 14,
                    "MaxAge": 100,
                },
            ]
        )
        books.to_csv(BOOKS_FILE, index=False)
def load_books():
    try:
        books = pd.read_csv(BOOKS_FILE)
    except FileNotFoundError:
        return pd.DataFrame()
    if "MaxAge" not in books.columns:
        books["MaxAge"] = 100
    return books
def save_history(name, age, language, genre):
    new_entry = pd.DataFrame(
        {
            "Name": [name],
            "Age": [age],
            "Language": [language],
            "Genre": [genre],
        }
    )
    new_entry.to_csv(
        HISTORY_FILE,
        mode="a",
        header=False,
        index=False,
    )
"""
RECOMMENDATION LOGIC in other word being logical
"""
def recommend_book():
    name = name_entry.get().strip()
    if not name:
        messagebox.showerror(
            "Error",
            "Please enter your name."
        )
        return
    try:
        age = int(age_entry.get())
        if age <= 0:
            raise ValueError
    except ValueError:
        messagebox.showerror(
            "Error",
            "Please enter a valid age."
        )
        return
    language = language_combo.get()
    if language not in LANGUAGES:
        messagebox.showerror(
            "Error",
            "Please select a supported language."
        )
        return
    genre = genre_combo.get()
    if genre not in GENRES:
        messagebox.showerror(
            "Error",
            "Please select a supported genre."
        )
        return
    books = load_books()
    recommendations = books[
        (books["Language"].str.lower() == language.lower())
        & (books["Genre"].str.lower() == genre.lower())
        & (books["MinAge"] <= age)
        & (books["MaxAge"] >= age)
    ]
    save_history(name, age, language, genre)
    if recommendations.empty:
        result_label.config(
            text="No matching books found."
        )
    else:
        book = recommendations.iloc[0]
        result_label.config(
            text=f"Recommended Book:\n{book['Title']}"
        )
def view_history():
    try:
        history = pd.read_csv(HISTORY_FILE)
        history_window = tk.Toplevel(root)
        history_window.title("Search History")
        history_window.geometry("500x300")
        text = tk.Text(history_window)
        text.pack(fill="both", expand=True)
        text.insert("1.0", history.to_string(index=False))
    except FileNotFoundError:
        messagebox.showinfo(
            "History",
            "No history available."
        )
def show_statistics():
    try:
        history = pd.read_csv(HISTORY_FILE)
        if history.empty:
            messagebox.showinfo(
                "Statistics",
                "No data available."
            )
            return
        total_searches = len(history)
        popular_genre = history["Genre"].mode()[0]
        stats = (
            f"Total Searches: {total_searches}\n\n"
            f"Most Popular Genre: {popular_genre}"
        )
        messagebox.showinfo(
            "Statistics",
            stats,
        )
    except FileNotFoundError:
        messagebox.showerror(
            "Error",
            "History file not found."
        )
"""
GUI que se dice GIO
"""
create_books_file()
create_history_file()
root = tk.Tk()
root.title("BookMatch")
root.geometry("500x450")
title_label = tk.Label(
    root,
    text="BookMatch",
    font=("Arial", 20, "bold")
)
title_label.pack(pady=10)
# Name
tk.Label(root, text="Name").pack()
